{
  "name": "anki-mindmap",
  "version": "0.2.0-alpha.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && python3 scripts/check_react.py",
    "test": "tsx --test tests/react/core.test.ts && node tests/react/browser.cjs",
    "test:core": "tsx --test tests/react/core.test.ts",
    "test:browser": "node tests/react/browser.cjs",
    "package": "python3 scripts/build_react_package.py",
    "test:desktop": "python3 tests/react/desktop.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
